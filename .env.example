# Configure um dos provedores. Se ambos existirem, o OpenRouter terá prioridade.
OPENROUTER_API_KEY=
OPENROUTER_HANDWRITING_MODEL=openai/gpt-4o-mini
# Opcionais para identificar o aplicativo no OpenRouter.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Letalk Quadro

# Alternativa direta pela OpenAI.
OPENAI_API_KEY=
OPENAI_HANDWRITING_MODEL=gpt-4o-mini

# Vercel Blob privado usado exclusivamente pelo painel /metas.
# Ao conectar o Blob ao projeto pela Vercel, esta variável é criada automaticamente.
BLOB_READ_WRITE_TOKEN=
